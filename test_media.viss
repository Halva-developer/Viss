$import lib "iostream" as io
$import lib "media" as media

!main {
    io.println("=== Testing Viss Media & Audio Metadata Library ===")

    @file = "test_sample.ogg"
    io.println("1. Checking if file is ready & unlocked:")
    @ready = media.is_file_ready(@file)
    io.println("File ready: " + @ready)

    io.println("2. Reading Vorbis metadata tags:")
    @tag = media.read(@file)
    io.println("Title: " + @tag["title"])
    io.println("Artist: " + @tag["artist"])
    io.println("Format: " + @tag["format"])
    io.println("Channels: " + @tag["channels"])
    io.println("Sample rate: " + @tag["sample_rate"])

    io.println("3. Embedding album art (viss_logo.jpg) into Ogg Vorbis track:")
    @cover_img = "viss_logo.jpg"
    @ok = media.embed_cover(@file, @cover_img, "test_sample_covered.ogg")
    io.println("Embedded cover result: " + @ok)

    io.println("4. Reading covered track:")
    @tag2 = media.read("test_sample_covered.ogg")
    io.println("Covered track Title: " + @tag2["title"])
    io.println("Has cover art: " + @tag2["has_cover"])

    io.println("SUCCESS: Audio metadata & cover embedding verified cleanly! ^_^")
}
