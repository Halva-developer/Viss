{
  "Function": {
    "prefix": "func",
    "body": [
      "!func ${1:name}(${2:params}) {",
      "    $0",
      "}"
    ],
    "description": "Define a Viss function"
  },
  "Async Function": {
    "prefix": "asyncfunc",
    "body": [
      "!async func ${1:name}(${2:params}) {",
      "    $0",
      "}"
    ],
    "description": "Define an asynchronous Viss function"
  },
  "Main Function": {
    "prefix": "main",
    "body": [
      "!func main() {",
      "    $0",
      "}"
    ],
    "description": "Main entry point function"
  },
  "Class Definition": {
    "prefix": "class",
    "body": [
      "!class ${1:ClassName} {",
      "    !func main(${2:params}) {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Define a Viss class"
  },
  "Raw Bytes Buffer": {
    "prefix": "bytes",
    "body": [
      "&${1:buffer} create | bytes${2:, 1024};",
      "$0"
    ],
    "description": "Create a low-level byte buffer (default 1024 bytes)"
  },
  "Raw Bits Buffer": {
    "prefix": "bits",
    "body": [
      "&${1:flags} create | bits${2:, 8192};",
      "$0"
    ],
    "description": "Create a low-level bitfield buffer (default 8192 bits)"
  },
  "For Range Loop": {
    "prefix": "for",
    "body": [
      "!for @${1:i} in ${2:0}..${3:10} {",
      "    $0",
      "}"
    ],
    "description": "Loop through numeric range"
  },
  "For Stepped Range Loop": {
    "prefix": "forstep",
    "body": [
      "!for @${1:i} in ${2:0}..${3:10}..${4:2} {",
      "    $0",
      "}"
    ],
    "description": "Loop through numeric range with custom step"
  },
  "Inline Lambda": {
    "prefix": "lambda",
    "body": [
      "!func(@${1:x}) { !return ${2:@x > 0}; }"
    ],
    "description": "Inline anonymous lambda function"
  },
  "For In Collection": {
    "prefix": "forin",
    "body": [
      "!for ${1:item} in @${2:collection} {",
      "    $0",
      "}"
    ],
    "description": "Iterate over list or collection"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "!while (${1:condition}) {",
      "    $0",
      "}"
    ],
    "description": "While loop block"
  },
  "If Condition": {
    "prefix": "if",
    "body": [
      "?if (${1:condition}) {",
      "    $0",
      "}"
    ],
    "description": "Conditional if statement"
  },
  "Elif Condition": {
    "prefix": "elif",
    "body": [
      "?elif (${1:condition}) {",
      "    $0",
      "}"
    ],
    "description": "Conditional else-if branch"
  },
  "Pattern Match": {
    "prefix": "match",
    "body": [
      "?match @${1:value} {",
      "    case ${2:pattern} {",
      "        $3",
      "    }",
      "    else {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Pattern matching switch statement"
  },
  "Try Expect": {
    "prefix": "try",
    "body": [
      "?try {",
      "    $1",
      "}",
      "?expect Exception as @e {",
      "    io.println(i\"Error: @e\");",
      "}"
    ],
    "description": "Error handling try-expect block"
  },
  "Import Module": {
    "prefix": "import",
    "body": [
      "$import \"${1:std.io}\";"
    ],
    "description": "Import standard or external module"
  },
  "List Literal": {
    "prefix": "list",
    "body": [
      "@${1:items} = [${2:1, 2, 3}];"
    ],
    "description": "Initialize a typed/dynamic list literal"
  },
  "Map Literal": {
    "prefix": "map",
    "body": [
      "@${1:dict} = {\"${2:key}\": ${3:value}};"
    ],
    "description": "Initialize a map/dictionary literal"
  },
  "Async Spawn": {
    "prefix": "spawn",
    "body": [
      "@${1:task} = async.spawn(${2:func_name});",
      "async.await(@${1:task});"
    ],
    "description": "Spawn background task on thread pool and await result"
  },
  "Async Parallel For": {
    "prefix": "parallel_for",
    "body": [
      "async.parallel_for(${1:0}, ${2:count}, !func(@i) {",
      "    $0",
      "});"
    ],
    "description": "Parallel loop across all CPU cores"
  },
  "Stopwatch Benchmark": {
    "prefix": "stopwatch",
    "body": [
      "@sw = time.Stopwatch(true);",
      "$0",
      "@ms = @sw.restart();",
      "io.println(i\"Completed in {@ms} ms\");"
    ],
    "description": "High-precision code execution stopwatch"
  },
  "JSON Parse": {
    "prefix": "jsonparse",
    "body": [
      "@doc = json.parse(${1:json_string});",
      "@val = @doc.get(\"${2:key}\").as_str();"
    ],
    "description": "Parse JSON string and read property"
  },
  "Retro Game Loop (60 FPS)": {
    "prefix": "gameloop",
    "body": [
      "rt.InitScreen(${1:64}, ${2:36});",
      "rt.SetCompact(true);",
      "",
      "@running = true;",
      "!while (@running) {",
      "    @k = io.get_key();",
      "    ?if (@k == \"q\") { @running = false; }",
      "",
      "    rt.ClearScreen(0);",
      "    // Render game objects here",
      "    $0",
      "    rt.UpdateScreen();",
      "    time.sleep(16); // ~60 FPS",
      "}"
    ],
    "description": "Standard 60 FPS retro game loop with keyboard input"
  },
  "Retro Chiptune Sound": {
    "prefix": "sfx",
    "body": [
      "rt.PlaySfx(\"${1|jump,coin,stomp,powerup,hurt,bump,flag,gameover|}\");"
    ],
    "description": "Play preset 8-bit NES sound effect"
  },
  "Interpolated String": {
    "prefix": "istr",
    "body": [
      "i\"${1:Hello, }{@${2:name}}${3:!}\""
    ],
    "description": "Interpolated string with embedded expressions"
  },
  "Raw String": {
    "prefix": "rstr",
    "body": [
      "r\"${1:regex or path}\""
    ],
    "description": "Raw unescaped string"
  },
  "Byte String": {
    "prefix": "bstr",
    "body": [
      "b\"${1:binary data}\""
    ],
    "description": "ASCII byte literal string"
  },
  "Bytemask Buffer": {
    "prefix": "bytemask",
    "body": [
      "&${1:mask} create | bytemask, ${2:16};",
      "$0"
    ],
    "description": "Create a 1D byte-mask buffer"
  },
  "Colormask Palette": {
    "prefix": "colormask",
    "body": [
      "&${1:pal} create | colormask, ${2:16};",
      "&${1:pal}.preset(\"${3|tetris,gameboy,pico8,nes,fire,cyberpunk,monochrome,neon,c64,matrix,lava,pastel|}\");",
      "&${1:pal}.apply();",
      "$0"
    ],
    "description": "Create and apply an RGB colormask palette"
  },
  "Spatial Mask Grid": {
    "prefix": "spatialmask",
    "body": [
      "&${1:stencil} create | mask, ${2:1024};",
      "$0"
    ],
    "description": "Create a 2D spatial byte mask"
  },
  "Mask Preset": {
    "prefix": "maskpreset",
    "body": [
      "mask.preset(&${1:mask}, \"${2|tetris,gameboy,pico8,nes,fire,cyberpunk,monochrome,neon,c64,matrix,lava,pastel|}\");"
    ],
    "description": "Load preset into byte-mask palette"
  },
  "Mask Stencil": {
    "prefix": "maskstencil",
    "body": [
      "mask.apply_stencil(&${1:dest}, &${2:src}, &${3:stencil}, ${4:1});"
    ],
    "description": "Apply 2D stencil masking to buffer"
  },
  "Mask Alpha Blend": {
    "prefix": "maskblend",
    "body": [
      "mask.blend(&${1:dest}, &${2:src_a}, &${3:src_b}, &${4:alpha_mask});"
    ],
    "description": "Alpha blend two buffers using 8-bit mask"
  },
  "Mask 2D Collision": {
    "prefix": "maskcollision",
    "body": [
      "mask.collides_2d(&${1:a}, ${2:ax}, ${3:ay}, ${4:aw}, ${5:ah}, &${6:b}, ${7:bx}, ${8:by}, ${9:bw}, ${10:bh}, 0)"
    ],
    "description": "Pixel-perfect 2D mask collision check"
  },
  "GUI Window Application": {
    "prefix": "guiapp",
    "body": [
      "$import lib \"gui\" as gui",
      "",
      "!main {",
      "    gui.create_window(\"${1:Viss App}\", ${2:800}, ${3:600});",
      "    @checked = false;",
      "    @name = \"\";",
      "    ",
      "    !while (gui.poll()) {",
      "        gui.label(20, 20, \"${1:Viss App}\", 20);",
      "        gui.text_input(20, 60, 260, 36, \"name_in\", @name, \"Enter name...\");",
      "        gui.checkbox(20, 110, \"Enable feature\", @checked);",
      "        ?if (gui.button(20, 150, 120, 36, \"Click Me\")) {",
      "            gui.label(160, 155, \"Clicked!\", 14);",
      "        }",
      "    }",
      "}"
    ],
    "description": "Native Windows hardware-accelerated GUI application boilerplate"
  },
  "Audio SFX & BGM": {
    "prefix": "audioapp",
    "body": [
      "$import lib \"audio\" as audio",
      "",
      "!main {",
      "    audio.play_bgm(\"${1:theme.mp3}\", 0.5);",
      "    audio.laser();",
      "    audio.play_note(\"C4\", 200, \"square\", 0.4);",
      "}"
    ],
    "description": "Audio music and sound effect playback boilerplate"
  },
  "Media Audio Tagging": {
    "prefix": "mediatag",
    "body": [
      "$import lib \"media\" as media",
      "",
      "!main {",
      "    @tag = media.read(\"${1:song.ogg}\");",
      "    media.write_tags(\"${1:song.ogg}\", {",
      "        \"TITLE\": \"${2:Song Title}\",",
      "        \"ARTIST\": \"${3:Artist Name}\"",
      "    });",
      "}"
    ],
    "description": "Read and update audio metadata tags"
  },
  "Media Video Generator": {
    "prefix": "mediarender",
    "body": [
      "$import lib \"media\" as media",
      "",
      "!main {",
      "    media.start_render_video(\"${1:song.ogg}\", \"${2:cover.jpg}\", \"${3:video.mp4}\");",
      "    !while (media.is_rendering_video()) {",
      "        @pct = media.get_render_video_progress();",
      "        time.sleep(250);",
      "    }",
      "}"
    ],
    "description": "Render high-resolution MP4 video from audio and cover art"
  }
}
