// Test of all modern Viss 2.0 Standard Libraries

!func compute_heavy_task() {
    io.println("[Async Worker] Background task started on thread pool!");
    async.sleep(50);
    io.println("[Async Worker] Background task completed!");
}

!func main() {
    io.println("==================================================");
    io.println("       VISS 2.0 STANDARD LIBRARIES SUITE          ");
    io.println("==================================================");

    // 1. Time & Stopwatch
    @sw = time.Stopwatch(true);
    @start_ms = time.now_ms();
    io.println("[Time] Current Epoch (ms):", @start_ms);

    // 2. Math & Lerp
    @lerped = math.lerp(10.0, 50.0, 0.5);
    @dist = math.distance(0.0, 0.0, 3.0, 4.0);
    io.println("[Math] Lerp(10, 50, 0.5) =", @lerped, "| Distance(0,0 -> 3,4) =", @dist);

    // 3. Crypto: SHA-256 & UUID
    @hash = crypto.sha256("Viss-Speed");
    @uid = crypto.uuid();
    io.println("[Crypto] SHA-256('Viss-Speed'):", @hash);
    io.println("[Crypto] Random UUID v4:", @uid);

    // 4. JSON: Parse & Stringify
    @raw_json = "{\"status\":\"ok\",\"code\":200,\"name\":\"Halva\"}";
    @doc = json.parse(@raw_json);
    @stat = @doc.get("status").as_str();
    @code_val = @doc.get("code").as_int();
    io.println("[JSON] Parsed status:", @stat, "| Code:", @code_val);

    // 5. Environment & Process
    @os_name = env.os();
    @cores = env.cpu_count();
    @work_dir = env.cwd();
    io.println("[Env] OS:", @os_name, "| CPU Cores:", @cores);
    io.println("[Env] CWD:", @work_dir);

    // 6. String Manipulation
    @s = "hello,world,viss";
    @words = str.split(@s, ",");
    @upper = str.upper(@s);
    io.println("[Str] Upper:", @upper, "| Words count:", @words.len);

    // 7. Async concurrency
    @task = async.spawn(compute_heavy_task);
    async.await(@task);

    @elapsed_ms = @sw.restart();
    io.println("[Stopwatch] Entire test suite completed in", @elapsed_ms, "ms!");
    io.println("==================================================");
    io.println("✔ ALL STANDARD MODULES WORKING BEAUTIFULLY! ^_^");
}
