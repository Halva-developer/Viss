!func main() {
    io.println("=== Testing Viss v0.2.1 New Features ===");

    // 1. Negative indexing on Lists
    @arr = [10, 20, 30, 40, 50];
    io.println(i"arr[-1] = {@arr[-1]} (expected 50)");
    io.println(i"arr[-2] = {@arr[-2]} (expected 40)");

    // 2. Slicing with negative indices
    @tail = @arr[-3..];
    io.println(i"arr[-3..] size = {@tail.size()} items = {@tail.join(\", \")}");

    // 3. Reverse range loop
    io.print("Reverse loop 5..1: ");
    !for @i in 5..1 {
        io.print(i"{@i} ");
    }
    io.println("");

    // 4. Stepped range loop
    io.print("Stepped loop 0..10..2: ");
    !for @x in 0..10..2 {
        io.print(i"{@x} ");
    }
    io.println("");

    io.print("Stepped reverse loop 10..0..-3: ");
    !for @y in 10..0..-3 {
        io.print(i"{@y} ");
    }
    io.println("");

    // 5. all and any with inline lambdas
    @all_pos = @arr.all(!func(@x) { !return @x > 0; });
    @has_30 = @arr.any(!func(@x) { !return @x == 30; });
    @has_999 = @arr.any(!func(@x) { !return @x == 999; });
    io.println(i"all > 0: {@all_pos}, any == 30: {@has_30}, any == 999: {@has_999}");

    // 6. sys.choice and sys.shuffle
    @picked = sys.choice(@arr);
    io.println(i"Random choice from arr: {@picked}");
    @shuffled = sys.shuffle(@arr);
    io.println(i"Shuffled arr: {@shuffled.join(\", \")}");

    // 7. math.wrap
    @w1 = math.wrap(105, 0, 100);
    @w2 = math.wrap(-5, 0, 100);
    io.println(i"math.wrap(105, 0, 100) = {@w1} (expected 5)");
    io.println(i"math.wrap(-5, 0, 100) = {@w2} (expected 95)");

    // 8. io.cursor_hide / cursor_show
    io.cursor_hide();
    io.cursor_show();
    io.println("Cursor hide/show OK!");

    io.println("=== All v0.2.1 tests passed cleanly! ===");
}
