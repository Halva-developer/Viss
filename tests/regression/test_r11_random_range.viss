$import lib "io" as io
$import lib "sys" as sys
$import lib "math" as math
!main {
    @maxv = 0;
    @minv = 1000000;
    for @i in 0..20000 {
        @r = sys.random(0, 100000);
        ?if (@r > @maxv) { @maxv = @r; }
        ?if (@r < @minv) { @minv = @r; }
    }
    io.println(@maxv > 90000);
    io.println(@minv >= 0);
    @hit_max = false;
    for @i in 0..2000 {
        ?if (math.random_int(1, 3) == 3) { @hit_max = true; }
    }
    io.println(@hit_max);
}
// EXPECT: true
// EXPECT: true
