$import lib "io" as io
$import lib "str" as str
$import lib "math" as math
!main {
    io.println("  ab  " |> str.trim |> str.upper);
    io.println(str.join(["x", "y"], "-" |> str.upper));
    @v = math.max(1.0, 9.0 |> math.clamp(0.0, 5.0));
    io.println(@v);
}
// EXPECT: AB
// EXPECT: x-y
// EXPECT: 5
