$import lib "io" as io
struct Counter {
    count = 0
    label = "c"
    ratio = 0.5
    !func inc() {
        @count += 1
    }
}
!main {
    @c = Counter();
    @c.inc();
    @c.inc();
    io.println(@c.count);
    io.println(@c.label);
    io.println(@c.count / 2);
}
// EXPECT: 2
// EXPECT: c
// EXPECT: 1
