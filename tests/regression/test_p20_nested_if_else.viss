$import lib "io" as io
!func cls(n as int) -> str {
    ?if n < 0 {
        return "neg";
    } else if n == 0 {
        return "zero";
    } else {
        ?if n > 100 { return "big"; }
        return "pos";
    }
}
!main {
    io.println(cls(-1));
    io.println(cls(0));
    io.println(cls(5));
    io.println(cls(500));
}
// EXPECT: neg
// EXPECT: zero
// EXPECT: pos
// EXPECT: big
