$import lib "io" as io;

!main {
    io.println("=== 1. BUFFER METHODS ON &palette (colormask, 16) ===");
    &palette create | colormask, 16;
    &palette.preset("neon");
    io.println("Neon preset loaded! Palette colors count:", &palette.color_count());
    io.println("Color 1 -> R:", &palette.get_r(1), "G:", &palette.get_g(1), "B:", &palette.get_b(1));

    &palette.set_hsv(2, 120.0, 1.0, 0.8);
    io.println("Color 2 set to HSV (120 deg) -> G:", &palette.get_g(2));

    @idx = &palette.nearest(0, 200, 0);
    io.println("Nearest color to pure green (0, 200, 0): index", @idx);

    &palette.brightness(20);
    &palette.contrast(1.2);
    io.println("Brightness and contrast adjustments applied!");

    io.println("=== 2. BUFFER METHODS ON &grid (bytemask, 16, 16) ===");
    &grid create | bytemask, 16, 16;
    &grid.rect_2d(16, 16, 2, 2, 8, 8, 1);
    &grid.circle_2d(16, 16, 8, 8, 4, 2);
    &grid.line_2d(16, 16, 0, 0, 15, 15, 3);
    io.println("Drew 2D rectangle, circle, and line on 16x16 grid!");
    io.println("Grid pixel (8, 8):", &grid.get_2d(8, 8, 16));

    @dist = &grid.raycast_2d(16, 16, 0.0, 0.0, 1.0, 1.0, 20.0, 3);
    io.println("Raycast from (0,0) towards (1,1) hit solid id 3 at distance:", @dist);

    io.println("=== 3. BITWISE & SEARCH BUFFER METHODS ===");
    &b1 create | bytes, 8;
    &b1.fill(255);
    &b2 create | bytes, 8;
    &b2.fill(15);
    @b_res = &b1 & &b2;
    io.println("Bitwise & operator byte 0:", @b_res[0]);

    @matches = @b_res.count_matching(15);
    io.println("Matching bytes with value 15:", @matches);

    &b1.and_with(&b2);
    io.println("In-place &b1.and_with(&b2) byte 0:", &b1[0]);

    io.println("=== 4. SERIALIZATION DIRECTLY ON BUFFER ===");
    @hex_str = &b2.to_hex();
    io.println("Mask in hex format:", @hex_str);
    &loaded create | bytes, 8;
    &loaded.from_hex(@hex_str);
    io.println("Loaded buffer from hex byte 0 is:", &loaded[0]);

    io.println("ALL DIRECT BUFFER METHOD TESTS PASSED!");
}
