{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Viss: Run Active File",
      "type": "shell",
      "command": "python \"${workspaceFolder}/viss.py\" run \"${file}\"",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Viss: Compile Active File",
      "type": "shell",
      "command": "python \"${workspaceFolder}/viss.py\" compile \"${file}\"",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Viss: Check Syntax",
      "type": "shell",
      "command": "python \"${workspaceFolder}/viss.py\" check \"${file}\"",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
