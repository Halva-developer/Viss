// Pure Viss execution without any C++ or g++ intermediary!
$import lib "iostream" as io
$import lib "math" as math
$import lib "str" as str

!func greet(name) {
    io.println("Hello from VM function, " + name + "!")
    !return "greeted"
}

!main {
    io.println("=== Testing VissVM Native Direct Execution ===")

    @x = 10
    @y = 25
    @z = @x + @y * 2
    io.println("Computed arithmetic (10 + 25 * 2): " + @z)

    @msg = "viss direct engine"
    io.println("Upper string: " + str.upper(@msg))

    io.println("Math sqrt(144): " + math.sqrt(144))

    @items = [10, 20, 30, 40, 50]
    io.println("List len: " + @items.len)
    io.println("List first: " + @items.first)
    io.println("List last: " + @items.last)

    @mapped = @items.map(|n| n * 3)
    io.println("Mapped list (* 3): " + @mapped)

    @filtered = @mapped.filter(|n| n > 60)
    io.println("Filtered list (> 60): " + @filtered)

    io.println("Calling custom function:")
    greet("Halvik")

    io.println("Testing while loop:")
    @count = 3
    !while (@count > 0) {
        io.println("Countdown: " + @count)
        @count -= 1
    }

    io.println("Testing for-range loop:")
    !for @i in 1..4 {
        io.println("Iteration: " + @i)
    }

    io.println("SUCCESS: Direct VM execution complete without any C++ or g++! ^_^")
}
