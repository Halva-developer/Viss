$import lib "iostream" as io
$import lib "retrotech" as rt

!main {
    rt.screen.create(32, 24, 1);
    rt.screen.window("Viss Retro Window Demo", 8);

    // Draw colored retro shapes
    rt.screen.rect(2, 2, 8, 8, 2);
    rt.screen.rect(12, 4, 10, 6, 5);
    rt.screen.rect(6, 12, 14, 6, 6);

    rt.screen.update();
    io.println("Native pixel-art window opened and rendered successfully!");
    !for @i in 0..10 {
        rt.screen.update();
        time.sleep_ms(16);
    }
    io.println("Window update loop verified!");
}
