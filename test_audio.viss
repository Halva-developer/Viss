$import lib "iostream" as io
$import lib "audio" as audio
$import lib "sys" as sys

!main {
    io.println("--- Testing Viss Dedicated Audio Engine ---")
    
    io.println("1. Setting master volume...")
    audio.set_volume(0.8)

    io.println("2. Playing procedural SFX 'coin'...")
    audio.sfx("coin")
    sys.sleep(200)

    io.println("3. Playing procedural SFX 'powerup'...")
    audio.sfx("powerup")
    sys.sleep(300)

    io.println("4. Playing musical notes (C4, E4, G4 chord arpeggio)...")
    audio.play_note("C4", 100, "square", 0.4)
    sys.sleep(100)
    audio.play_note("E4", 100, "square", 0.4)
    sys.sleep(100)
    audio.play_note("G4", 150, "sine", 0.5)
    sys.sleep(200)

    io.println("5. Synth custom ADSR wave...")
    audio.synth(440.0, 150, "sawtooth", 10.0, 30.0, 0.5, 40.0, 0.4)
    sys.sleep(200)

    io.println("OK: Audio Engine verified successfully! ^_^")
}
