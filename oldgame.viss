$import lib "iostream" as io
$import lib "retrotech" as rt
$import lib "mask" as m
!func main() {
    &pballete create | bytes, 48;
    &pballete grid set 16,3;
    &pballete grid edit {
        0, 0, 0:
        100, 100, 100:
        125, 90, 30:
        50, 105, 250:
        40, 145, 240:
        100, 200, 300:
        300, 200, 100:
        230, 10, 30;
    }
    rt.screen.apply(&pballete);
    rt.screen.create(30,30,0);
}