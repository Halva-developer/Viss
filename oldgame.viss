$import lib "iostream" as io
$impoer lib "retrotech" as rt
!func main() {
    &colormask create | bytes, 3;  // создал маску цвета, кол-во байтов 3
    &colormask[0] = 50; // красный
    &colormask[1] = 61;   // зеленый
    &colormask[2] = 70; // синий
    &map create | bytes; // создал сетку карты, количество байтов 1024
    &map = map.fill_map!(map, 100) // построил карту с паттерном 100

    rt.DrawRawPixels(&map, 32, 32 ); // отрисовал эту сетку
    rt.ColorScreen(&colormask, &map) // окрасил экран с помощью маски, используя значение пикселей из сетки карты
    rt.UpdateScreen(); // обновил экран
}

!class map {

    !func fill_map!(map, pattern) {
        pattern.clamp(100, 350)
        for @i in 0..map.size() {
            @block = int.random(pattern - double.sqrt(pattern), pattern + double.sqrt(pattern + 3)) | int;
            @block.clamp(0, 255);
            &map[@i] = @block;
        }
        
        return(&map);

    }

}