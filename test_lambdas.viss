$import lib "iostream" as io

!main {
    io.println("--- Testing Viss Closures & Lambdas ---")
    @nums = [1, 2, 3, 4, 5]
    io.println("Original: " + @nums)

    @doubled = @nums.map(|x| x * 2)
    io.println("Doubled: " + @doubled)

    @evens = @doubled.filter(|x| x > 4)
    io.println("Filtered (> 4): " + @evens)

    @sum = @nums.reduce(0, |acc, x| acc + x)
    io.println("Sum: " + @sum)

    io.println("OK: Lambdas verified!")
}
