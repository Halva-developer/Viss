$import lib "retrotech" as rt
$import lib "iostream" as io

!func main() {
    io.println("=== TEST 1: HYBRID BUFFERS (гибрид-байтность) ===");
    // 3 bytes + 4 bits = 7 cells, 4 bytes physical RAM footprint
    &data create | bytes, 3, bits, 4;

    &data[0] = 250;
    &data[1] = 120;
    &data[2] = 42;

    &data[3] = 1;
    &data[4] = 0;
    &data[5] = 1;
    &data[6] = 1;

    io.print("Hybrid logical cells: ");
    io.println(&data.size());
    io.print("Physical RAM: ");
    io.print(&data.memory_size());
    io.println(" bytes (3 bytes + 1 byte for 4 bits)");

    io.print("Byte 0: ");
    io.println(&data[0]);
    io.print("Byte 1: ");
    io.println(&data[1]);
    io.print("Byte 2: ");
    io.println(&data[2]);
    io.print("Bit 3 (flag 0): ");
    io.println(&data[3]);
    io.print("Bit 4 (flag 1): ");
    io.println(&data[4]);
    io.print("Bit 5 (flag 2): ");
    io.println(&data[5]);
    io.print("Bit 6 (flag 3): ");
    io.println(&data[6]);

    io.println("");
    io.println("=== TEST 2: MULTI-LAYER GRID (grid 4,2 3,1) ===");
    // 3 layers: 2 layers of thickness 4, 1 layer of thickness 3
    &world create | grid 4,2 3,1;

    io.print("Total layers: ");
    io.println(&world.layer_count());
    io.print("Total depth: ");
    io.println(&world.total_depth());
    io.print("Layer 0 thickness: ");
    io.println(&world.layer_thickness(0));
    io.print("Layer 1 thickness: ");
    io.println(&world.layer_thickness(1));
    io.print("Layer 2 thickness: ");
    io.println(&world.layer_thickness(2));

    &world.set(0, 5, 5, 2, 99);
    io.print("Value at Layer 0 (x=5, y=5, z=2): ");
    io.println(&world.get(0, 5, 5, 2));

    io.println("");
    io.println("=== TEST 3: SCREEN CONFIG (10 BYTES) ===");
    &cfg create | bytes, 10;
    &cfg[0] = 32;  // width
    &cfg[1] = 16;  // height
    &cfg[2] = 1;   // render_mode: compact half-block
    &cfg[3] = 0;   // palette: NES
    &cfg[4] = 60;  // 60 FPS
    &cfg[5] = 2;   // vsync
    &cfg[6] = 0;   // bg color: Sky blue
    &cfg[7] = 7;   // fg color: White
    &cfg[8] = 1;   // scale 1x
    &cfg[9] = 90;  // audio volume

    rt.screen.create(&cfg);
    io.println("Screen created successfully with 10-byte hardware config!");

    io.println("");
    io.println("=== TEST 4: SELF-CONTAINED 3-BYTE SPRITE ===");
    // 3 bytes header:
    // [0] = 4 (w)
    // [1] = 4 (h)
    // [2] = 0 (trans=0, 8-bit color, no flip)
    // [3..18] = 16 color pixels
    &mario create | bytes, 19;
    &mario[0] = 4;
    &mario[1] = 4;
    &mario[2] = 0;
    !for @p in 3..18 {
        &mario[@p] = 2; // Mario red
    }

    // Draw sprite using self-contained 3-byte header!
    .draw.sprite(&mario, 2, 2);
    io.println("Sprite drawn using self-contained 3-byte header (.draw.sprite)!");

    io.println("");
    io.println("All features functioning at 100%!");
}
