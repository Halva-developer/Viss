// =============================================================================
// Viss Example 05: Go-Style Concurrency Channels
// Run with: viss run examples/05_concurrency_channels.viss
// =============================================================================

$import lib "io" as io
$import lib "chan" as chan

!main {
    io.println("=== Go-Style Channels in Viss ===");

    // Buffered, thread-safe channel of strings with capacity 5
    @ch = chan.create<str>(5);

    // Send messages into the channel
    chan.send(@ch, "Task Alpha started");
    chan.send(@ch, "Data processing completed");
    chan.send(@ch, "Ready for deployment");

    io.println(i"Buffered messages: {chan.len(@ch)} of {chan.cap(@ch)}");

    // Receive messages in FIFO order
    @m1 = chan.recv(@ch);
    @m2 = chan.recv(@ch);
    @m3 = chan.recv(@ch);

    io.println(i"Received 1: {@m1}");
    io.println(i"Received 2: {@m2}");
    io.println(i"Received 3: {@m3}");

    // Close the channel
    chan.close(@ch);
    io.println(i"Channel is closed: {chan.is_closed(@ch)}");
}
