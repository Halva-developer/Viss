// =============================================================================
// Viss Example 06: Desktop GUI (immediate mode)
// Run with: viss run examples/06_crossplatform_gui.viss
//
// The gui module is immediate-mode: every frame you clear the window, draw
// everything, and check input. There are no widget objects - a "button" is a
// rectangle plus a click test.
// =============================================================================

$import lib "io" as io
$import lib "gui" as ui
$import lib "time" as time

!main {
    io.println("Opening Viss GUI window... close it to exit.");
    ui.create("Viss GUI Example", 640, 480);
    !defer ui.close()

    @clicks = 0;
    @btn_x = 30;
    @btn_y = 90;
    @btn_w = 180;
    @btn_h = 44;

    !while ui.is_open() {
        ui.poll();

        @mx = ui.mouse_x();
        @my = ui.mouse_y();
        @hover = @mx >= @btn_x and @mx <= @btn_x + @btn_w and @my >= @btn_y and @my <= @btn_y + @btn_h;
        ?if (@hover and ui.mouse_clicked()) {
            @clicks += 1;
            io.println(i"Button clicked {@clicks} time(s)");
        }

        ui.clear(ui.Color.rgb(15, 18, 30));
        ui.draw_text(30, 30, "Welcome to the native Viss desktop GUI!", ui.Color.rgb(230, 230, 240), 18);
        ?if (@hover) {
            ui.draw_round_rect(@btn_x, @btn_y, @btn_w, @btn_h, 10, ui.Color.rgb(70, 130, 255));
        } else {
            ui.draw_round_rect(@btn_x, @btn_y, @btn_w, @btn_h, 10, ui.Color.rgb(50, 100, 220));
        }
        ui.draw_text(@btn_x + 50, @btn_y + 12, "Click me", ui.Color.rgb(255, 255, 255), 16);
        ui.draw_text(30, 160, i"Clicks: {@clicks}", ui.Color.rgb(180, 200, 255), 16);

        ui.update();
        time.sleep_ms(16);
    }
}
