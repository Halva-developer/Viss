// =============================================================================
// Viss Example 04: Embedded Database (db module)
// Run with: viss run examples/04_sqlite_database.viss
//
// The db module is a small embedded document store saved as a JSON file.
// It understands a SQL subset (CREATE TABLE, INSERT, SELECT ... WHERE, UPDATE,
// DELETE, LIKE) - it is not SQLite. Use exec_params/query_params for user input.
// =============================================================================

$import lib "io" as io
$import lib "db" as db
$import lib "fs" as fs

!main {
    io.println("=== Opening embedded database ===");
    @path = "app_data.json";
    ?if (fs.exists(@path)) { fs.remove(@path); }
    @database = db.open(@path);

    db.exec(@database, "CREATE TABLE tasks (title STR, status STR)");

    // Parameters are never spliced into the SQL text, so quotes in values are safe.
    db.exec_params(@database, "INSERT INTO tasks VALUES (?, ?)", ["Implement Viss", "Completed"]);
    db.exec_params(@database, "INSERT INTO tasks VALUES (?, ?)", ["Build cross-platform binary", "Completed"]);
    db.exec_params(@database, "INSERT INTO tasks VALUES (?, ?)", ["Write the 'next' release", "Planned"]);

    io.println(i"Total task records: {db.count(@database, \"tasks\")}");

    @done = db.query_params(@database, "SELECT * FROM tasks WHERE status = ?", ["Completed"]);
    io.println(i"Completed tasks: {@done.len()}");

    io.println("Rows as JSON:");
    io.println(db.query_json(@database, "SELECT * FROM tasks"));

    // Transactions: nothing reaches the file until commit; rollback discards it.
    db.begin(@database);
    db.exec(@database, "DELETE FROM tasks");
    db.rollback(@database);
    io.println(i"After rollback: {db.count(@database, \"tasks\")} rows");

    db.close(@database);
    fs.remove(@path);
    io.println("Database closed and removed.");
}
